// Reglas de seguridad de la base (Firestore) — Limay Rock
// Se pegan a mano en la consola de Firebase: Firestore Database → Reglas.
// Este archivo es la copia de referencia de lo que está publicado.
//
// ETAPA 3: base cerrada también para el delivery. El celular del repartidor
// se habilita con la cuenta delivery@ y, al poner el PIN, la nube (función
// accesoRepartidor) le da un permiso a nombre de ese repartidor. Sin
// repartidor adentro, el celular no puede leer nada. Los PIN nunca llegan al
// celular: los empleados solo los ven la caja y el admin.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Equipos del local (caja y admin): acceso a todo.
    function local() {
      return request.auth != null
        && request.auth.token.email in ['local@limayrock.app', 'admin@limayrock.app'];
    }

    // Un repartidor adentro de un celular habilitado: el permiso lo da la nube
    // con su nombre (rep) y el del celular (disp). Se revisa en cada pedido que
    // siga existiendo, con acceso a delivery, y que el celular no esté dado de baja.
    function esRep() {
      return request.auth != null
        && request.auth.token.get('rep', null) is string
        && request.auth.token.get('disp', null) is string
        && exists(/databases/$(database)/documents/empleados/$(request.auth.token.rep))
        && (get(/databases/$(database)/documents/empleados/$(request.auth.token.rep)).data.get('accesoDelivery', false) == true
            || get(/databases/$(database)/documents/empleados/$(request.auth.token.rep)).data.get('rol', '') == 'admin')
        && get(/databases/$(database)/documents/dispositivos/$(request.auth.token.disp)).data.get('baja', false) != true;
    }
    // Caja, admin o repartidor adentro de su celular.
    function equipo() { return local() || esRep(); }

    // Catálogo web (público): solo puede VER productos, precios y stock.
    match /productos/{id}             { allow read: if true; }
    match /inventario/{id}            { allow read: if true; }
    match /combos/{id}                { allow read: if true; }
    match /promos/{id}                { allow read: if true; }
    match /itemsManualesCatalogo/{id} { allow read: if true; }
    match /config/{id} {
      allow read: if id in ['categoriasVista', 'gruposCategorias', 'deliveryActivo'];
    }

    // Pedidos del catálogo: un cliente solo puede CREAR un pedido nuevo (y
    // consultar si un pedido suyo ya llegó: solo se puede "leer" un pedido que
    // todavía no existe, así nunca ve datos de nadie).
    match /pedidosWeb/{id} {
      allow create: if true;
      allow get: if resource == null || equipo();
      allow list, update: if equipo();
    }

    // Seguimiento del pedido: el cliente puede VER el estado de SU pedido si
    // tiene el código secreto (no puede listar los demás). Solo trae la etapa,
    // sin datos personales. Lo escriben solo los equipos del local.
    match /seguimiento/{codigo} { allow get: if true; }

    // Opiniones (QR del local o "Valorá tu pedido"): el público solo puede
    // CREAR una opinión, con campos y largos controlados. No puede leer ni
    // cambiar ninguna: las ve solo el local en el admin. Las de un pedido van
    // con el código secreto del pedido y se puede dejar una sola por pedido.
    match /opiniones/{id} {
      allow create: if request.resource.data.keys().hasOnly(['estrellas','comentario','producto','nombre','telefono','novedades','origen','pedido','fecha'])
        && request.resource.data.estrellas is int
        && request.resource.data.estrellas >= 0 && request.resource.data.estrellas <= 5
        && request.resource.data.comentario is string && request.resource.data.comentario.size() <= 600
        && request.resource.data.producto is string && request.resource.data.producto.size() <= 200
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 80
        && request.resource.data.telefono is string && request.resource.data.telefono.size() <= 30
        && request.resource.data.novedades is bool
        && request.resource.data.fecha is string && request.resource.data.fecha.size() <= 40
        && ((request.resource.data.origen == 'local' && request.resource.data.pedido == null)
          || (request.resource.data.origen == 'pedido'
              && request.resource.data.pedido is string
              && id == 'pedido_' + request.resource.data.pedido
              && exists(/databases/$(database)/documents/seguimiento/$(request.resource.data.pedido))));
    }

    // Mensajes del local a los repartidores: los manda solo un equipo del
    // local (regla general de abajo). La app de delivery los puede VER y solo
    // marcar que los leyó (no puede cambiar el texto ni a quién va).
    match /avisosDelivery/{id} {
      allow read: if equipo();
      allow update: if equipo() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leidoPor']);
    }

    // Empleados (con los PIN): solo la caja y el admin. El repartidor solo puede
    // cambiar su propia disponibilidad, sin poder leer nada.
    match /empleados/{id} {
      allow read, write: if local();
      allow update: if esRep() && request.auth.token.rep == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disponibleDelivery']);
    }
    // Copia sin PIN de los repartidores (la arma la nube).
    match /repartidoresPub/{id} { allow read: if equipo(); }
    match /config/{id}       { allow write: if id == 'deliveryActivo' && equipo(); }
    match /fcmTokens/{id}    { allow read, write: if equipo(); }
    // Celulares: el admin los ve todos y los puede dar de baja. Cada celular
    // solo puede anotarse a sí mismo y nunca sacarse la baja.
    match /dispositivos/{id} {
      allow read, write: if local();
      allow create, update: if request.auth != null
        && (request.auth.token.email == 'delivery@limayrock.app' || request.auth.token.get('disp', '') == id)
        && request.resource.data.get('baja', false) == (resource == null ? false : resource.data.get('baja', false));
    }

    // Todo lo demás (ventas, caja, cierres, egresos, stock, fiados, etc.):
    // solo la caja y el admin (el celular de delivery NO).
    match /{document=**} { allow read, write: if local(); }
  }
}
