// Reglas de seguridad de la base (Firestore) — Limay Rock
// Se pegan a mano en la consola de Firebase: Firestore Database → Reglas.
// Este archivo es la copia de referencia de lo que está publicado.
//
// ETAPA 2 (parcial): cerrado todo lo importante; abierto solo lo que usa el
// panel de delivery, hasta identificar los celus de los repartidores.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Equipos identificados (ver lr-identificacion.js).
    // prueba@ es temporal, para verificar; se saca al terminar.
    function equipo() {
      return request.auth != null
        && request.auth.token.email in [
          'local@limayrock.app',
          'admin@limayrock.app',
          'delivery@limayrock.app',
          'prueba@limayrock.app'
        ];
    }

    // Catálogo web (público): solo puede VER productos, precios y stock.
    match /productos/{id}             { allow read: if true; }
    match /inventario/{id}            { allow read: if true; }
    match /combos/{id}                { allow read: if true; }
    match /promos/{id}                { allow read: if true; }
    match /itemsManualesCatalogo/{id} { allow read: if true; }
    match /config/{id} {
      allow read: if id in ['categoriasVista', 'gruposCategorias', 'deliveryActivo'];
    }

    // Pedidos del catálogo: un cliente solo puede CREAR un pedido nuevo.
    match /pedidosWeb/{id} { allow create: if true; }

    // TEMPORAL — lo que usa el panel de delivery, hasta identificar sus celus.
    match /pedidosWeb/{id} { allow read, update: if true; }
    match /empleados/{id}  { allow read, write: if true; }
    match /config/{id}     { allow write: if id == 'deliveryActivo'; }
    match /fcmTokens/{id}  { allow read, write: if true; }

    // Todo lo demás (ventas, caja, cierres, egresos, stock, fiados, etc.):
    // solo los equipos identificados.
    match /{document=**} { allow read, write: if equipo(); }
  }
}
