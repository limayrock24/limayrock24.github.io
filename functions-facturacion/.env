# Configuración de la facturación (nada de esto es secreto).
# simulado = no se conecta a ARCA (comprobantes de mentira, para probar)
# homologacion = ambiente de pruebas de ARCA (las facturas no valen)
# produccion = facturas reales
ARCA_MODO=homologacion
ARCA_CUIT=20433394896
ARCA_PTO_VTA=2
# "si": ya están cargados en Google ARCA_KEY, ARCA_CERT y ARCA_CERT_PRODUCCION.
ARCA_CON_SECRETOS=si
